{
  "name": "khet-data-trust",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype of FPO-led collective governance for shared agricultural data (synthetic data only)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:reset": "rm -f data/khet.db data/khet.db-wal data/khet.db-shm"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  }
}
